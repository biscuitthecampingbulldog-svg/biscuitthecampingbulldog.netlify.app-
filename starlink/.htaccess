# Starlink Mini Accessories shop. This folder belongs ONLY to starlink.biscuitthecampingbulldog.com.
# Keep the main site's page-address rules out of here, and send anyone who reaches this folder
# through Biscuit's address (biscuitthecampingbulldog.com/starlink) to the shop's own address.
RewriteEngine On
RewriteCond %{HTTP_HOST} !^starlink\. [NC]
RewriteRule ^(.*)$ https://starlink.biscuitthecampingbulldog.com/$1 [R=301,L]
