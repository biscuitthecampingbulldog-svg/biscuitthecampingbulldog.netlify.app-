# Xtreme Heaters shop. Since 11/10/26 (Jeffrey's call) it lives at biscuitthecampingbulldog.com/xtremeheaters/
# because its own subdomain isn't switched on. RewriteEngine On here keeps the main site's page rules out of this folder.
# If xtremeheaters.biscuitthecampingbulldog.com is ever switched on, its visits come here so the shop keeps one address.
DirectoryIndex index.html
RewriteEngine On
RewriteCond %{HTTP_HOST} ^xtremeheaters\. [NC]
RewriteRule ^(.*)$ https://biscuitthecampingbulldog.com/xtremeheaters/$1 [R=301,L]
RewriteRule ^$ index.html [L]
