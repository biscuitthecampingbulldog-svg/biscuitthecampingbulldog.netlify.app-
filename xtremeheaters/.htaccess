# Xtreme Heaters shop. This folder belongs ONLY to xtremeheaters.biscuitthecampingbulldog.com.
# Keep the main site's page-address rules out of here, and send anyone who reaches this folder
# through Biscuit's address (biscuitthecampingbulldog.com/xtremeheaters) to the shop's own address.
RewriteEngine On
RewriteCond %{HTTP_HOST} !^xtremeheaters\. [NC]
RewriteRule ^(.*)$ https://xtremeheaters.biscuitthecampingbulldog.com/$1 [R=301,L]
